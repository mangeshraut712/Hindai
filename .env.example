# Hind AI – Environment Variables
# Copy to .env.local for development

# ─────────────── OpenRouter API (production) ───────────────
# Get your API key from: https://openrouter.ai/keys
# Hind AI uses Google Gemma 4 only. Do not set Claude, OpenAI, or Gemini chat models.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ─────────────── Local Ollama (development, Gemma only) ───────────────
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:latest

# ─────────────── Upstash Redis (caching + rate limiting) ───────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─────────────── Supabase (optional persistence) ───────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────── Site URL (canonical link) ───────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────── Durable Gemma gateway (Cloudflare Worker) ───────────────
# Production GitHub Pages calls this Worker instead of missing /api routes.
# Default model is Workers AI @cf/google/gemma-4-26b-a4b-it (free).
# Optional Worker secret OPENROUTER_API_KEY upgrades to Gemma 4 31B.
# NEXT_PUBLIC_API_BASE=https://hindai-gemma.mangeshraut712.workers.dev
# NEXT_PUBLIC_HAS_SERVER_API=true

# ─────────────── Analytics (optional) ───────────────
# Google Analytics 4 measurement ID. Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
